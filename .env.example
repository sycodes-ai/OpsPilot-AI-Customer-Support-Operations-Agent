# Copy to .env. Without an API key the agent runs in deterministic "rules" mode.
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# Any OpenAI-compatible endpoint works, e.g. https://api.groq.com/openai/v1
LLM_BASE_URL=https://api.openai.com/v1
AGENT_MODE=auto
RATE_LIMIT_PER_MINUTE=30
CORS_ORIGINS=*
# DATABASE_URL=postgresql://user:pass@host:5432/opspilot   (default: local SQLite file)
